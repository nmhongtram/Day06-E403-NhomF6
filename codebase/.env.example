# Copy file này thành .env và điền giá trị thật
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)

# OpenAI API Key - lấy tại https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Model settings (có thể giữ nguyên)
OPENAI_MODEL_FAST=gpt-4o-mini      # dùng cho intent classification (rẻ + nhanh)
OPENAI_MODEL_SMART=gpt-4o-mini     # dùng cho policy explanation + room reasoning

# Server settings
PORT=8000
HOST=0.0.0.0
